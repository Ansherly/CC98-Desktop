<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="CC98.Views.DiscoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:ic="using:FluentIcons.WinUI"
      xmlns:obj="using:CC98.Objects"
      xmlns:picture="using:CC98.Controls"
      xmlns:infoFlower="using:CC98.Controls"
      xmlns:empty="using:CC98.Controls"
      NavigationCacheMode="Required"
      Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Page.Resources>

        <DataTemplate x:Key="ImagePost"
                      x:DataType="obj:TopicInfo">
            <HyperlinkButton HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             Padding="0"
                             CornerRadius="0"
                             HorizontalAlignment="Stretch">
                <Grid Tag="{x:Bind Id}"
                      Padding="15"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0.5,0,0.5"
                      RowSpacing="8"
                      Tapped="ContentCard_Tapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Border Width="30"
                                Height="30"
                                BorderThickness="0"
                                CornerRadius="9999"
                                Background="{ThemeResource PortraitBackgroundColor}">
                            <picture:Picture x:Name="portrait"
                                             Src="{x:Bind PortraitUrl}"
                                             LoadImageCallback="{StaticResource PortraitLoader}" />
                        </Border>
                        <TextBlock Text="{x:Bind UserName}"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource HarmonySansBold}"
                                   Foreground="LightSeaGreen" />
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Width="1"
                                Margin="0,4,0,4" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <ic:SymbolIcon Symbol="Chat"
                                           FontSize="14" />
                            <TextBlock Text="{x:Bind ReplyCount}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    Margin="5,0,0,0">
                            <ic:SymbolIcon Symbol="Fire"
                                           FontSize="14" />
                            <TextBlock Text="{x:Bind HitCount}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{x:Bind Time}"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Row="1"
                            Height="1"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Grid.Row="2"
                               Text="{x:Bind Title}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsRepeater Grid.Row="3"
                                   ItemsSource="{x:Bind MediaContent.Thumbnail}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MaximumRowsOrColumns="3"
                                               ItemsJustification="Start"
                                               MinColumnSpacing="15"
                                               MinRowSpacing="15" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border CornerRadius="4">
                                    <picture:Picture Src="{x:Bind}"
                                                     Stretch="UniformToFill"
                                                     MaxWidth="300"
                                                     LoadImageCallback="{StaticResource CustomPortraitLoader}" />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </HyperlinkButton>
        </DataTemplate>

        <DataTemplate x:Key="TextPost"
                      x:DataType="obj:TopicInfo">
            <HyperlinkButton VerticalContentAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             CornerRadius="0"
                             Padding="0">
                <Grid Padding="15"
                      x:Name="ContentCard"
                      Tag="{x:Bind Id}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0.5,0,0.5"
                      RowSpacing="8"
                      Tapped="ContentCard_Tapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Border Width="30"
                                Height="30"
                                BorderThickness="0"
                                CornerRadius="9999"
                                Background="{ThemeResource PortraitBackgroundColor}">
                            <picture:Picture x:Name="portrait"
                                             Src="{x:Bind PortraitUrl}"
                                             LoadImageCallback="{StaticResource PortraitLoader}" />
                        </Border>
                        <TextBlock Text="{x:Bind UserName}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource HarmonySansBold}"
                                   Foreground="LightSeaGreen" />
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Width="1"
                                Margin="0,4,0,4" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <ic:SymbolIcon Symbol="Chat"
                                           FontSize="14" />
                            <TextBlock Text="{x:Bind ReplyCount}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    Margin="5,0,0,0">
                            <ic:SymbolIcon Symbol="Fire"
                                           FontSize="14" />
                            <TextBlock Text="{x:Bind HitCount}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{x:Bind Time}"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Grid.Row="1"
                            Height="1"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind Title}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </HyperlinkButton>

        </DataTemplate>
        <obj:TopicTemplateSelector x:Key="PostTemplateSelector"
                                   ImageTemplate="{StaticResource ImagePost}"
                                   TextTemplate="{StaticResource TextPost}" />
    </Page.Resources>


    <Grid x:Name="RootGrid"
          Padding="15"
          ColumnSpacing="10"
          RowSpacing="20"
          Background="{ThemeResource CardGradient2Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="发现"
                   FontWeight="Bold"
                   FontSize="22"
                   Margin="10" />
        <Button Grid.Column="1"
                Grid.Row="0"
                x:Name="RefRandomTiles"
                Click="RefRandomTiles_Click"
                Padding="7"
                BorderThickness="0">
            <ic:SymbolIcon Symbol="ArrowSync" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="0"
                      x:Name="NewTopicViewer">
            <ItemsRepeater ItemTemplate="{StaticResource PostTemplateSelector}"
                           ItemsSource="{x:Bind Topics}"
                           ElementPrepared="ItemsRepeater_ElementPrepared">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <empty:EmptyStateControl x:Name="DiscoverEmptyState"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 IconGlyph="&#xEC4F;"
                                 Title="暂无内容"
                                 Subtitle="这里还没有内容" />


        <ScrollViewer x:Name="RandomTopicViewer"
                      Grid.Row="1"
                      Grid.Column="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="5"
                      Padding="10">
            <ItemsRepeater x:Name="RandomTiles"
                           ItemsSource="{x:Bind RandomTopics}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical"
                                 Spacing="5" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="obj:SimpleTopicInfo">
                        <HyperlinkButton Padding="8"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         x:Name="RandomPost"
                                         Click="RandomPost_Click"
                                         DataContext="{x:Bind}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ic:SymbolIcon Symbol="Chat"
                                               Grid.Column="0" />
                                <TextBlock Text="{x:Bind Title}"
                                           FontSize="13"
                                           Grid.Column="1"
                                           TextWrapping="Wrap" />
                            </Grid>

                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollViewer>
        <infoFlower:InfoFlower x:Name="Flower"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" />
    </Grid>
</Page>