<?xml version="1.0" encoding="utf-8" ?>

<Window x:Class="CC98.Views.MediaViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:ic="using:FluentIcons.WinUI"
        xmlns:picture="using:CC98.Controls"
        xmlns:infoFlower="using:CC98.Controls"
        Title="预览">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"
                           MinHeight="60" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              x:Name="GridTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="CC98 预览"
                       Margin="10,0,5,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="15"
                       x:Name="de" />

        </Grid>
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                MinWidth="80"
                Height="32"
                CornerRadius="16"
                Background="{ThemeResource AcrylicCardBrush}">
            <TextBlock x:Name="Posi"
                       Text="1/1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        CornerRadius="0,6,6,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <HyperlinkButton Background="Transparent"
                                 Width="48"
                                 Height="48"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 x:Name="zoomin"
                                 Click="zoomin_Click"
                                 ToolTipService.ToolTip="放大"
                                 CornerRadius="0"
                                 BorderThickness="0">
                    <ic:SymbolIcon Symbol="ZoomIn" />
                </HyperlinkButton>
                <Border Height="32">
                    <TextBlock Text="100%"
                               Padding="0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               x:Name="zoomfactor" />
                </Border>
                <HyperlinkButton Background="Transparent"
                                 x:Name="zoomout"
                                 Width="48"
                                 Height="48"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Click="zoomout_Click"
                                 ToolTipService.ToolTip="缩小"
                                 CornerRadius="0"
                                 BorderThickness="0">
                    <ic:SymbolIcon Symbol="ZoomOut" />
                </HyperlinkButton>
                <HyperlinkButton Background="Transparent"
                                 x:Name="Rotate"
                                 Width="48"
                                 Height="48"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Click="Rotate_Click"
                                 ToolTipService.ToolTip="旋转"
                                 CornerRadius="0"
                                 BorderThickness="0">
                    <ic:SymbolIcon Symbol="RotateRight" />
                </HyperlinkButton>
                <HyperlinkButton Background="Transparent"
                                 x:Name="CopyPic"
                                 Width="48"
                                 Height="48"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Click="CopyPic_Click"
                                 ToolTipService.ToolTip="复制"
                                 CornerRadius="0"
                                 BorderThickness="0">
                    <ic:SymbolIcon Symbol="Copy" />
                </HyperlinkButton>
                <HyperlinkButton Background="Transparent"
                                 x:Name="SavePic"
                                 Width="48"
                                 Height="48"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Click="SavePic_Click"
                                 ToolTipService.ToolTip="保存"
                                 CornerRadius="0"
                                 BorderThickness="0">
                    <ic:SymbolIcon Symbol="Save" />
                </HyperlinkButton>
            </StackPanel>
            <Button x:Name="last"
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    CornerRadius="9999"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ScrollButtonStyle}"
                    Click="last_Click">
                <FontIcon FontSize="{ThemeResource FlipViewButtonFontSize}"
                          Glyph="&#xedd9;" />
            </Button>
            <ScrollViewer Grid.Column="2"
                          ZoomMode="Enabled"
                          x:Name="Viewer"
                          ViewChanged="Viewer_ViewChanged"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Stretch"
                          HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Visible"
                          HorizontalAlignment="Stretch">
                <picture:Picture x:Name="InnerImage"
                                 Stretch="Uniform"
                                 LoadImageCallback="{StaticResource CustomPortraitLoader}"
                                 RenderTransformOrigin="0.5,0.5"
                                 HorizontalAlignment="Center">
                    <picture:Picture.RenderTransform>
                        <RotateTransform x:Name="ImageTransform"
                                         Angle="0" />
                    </picture:Picture.RenderTransform>
                </picture:Picture>
            </ScrollViewer>

            <Button x:Name="next"
                    Grid.Column="3"
                    Width="30"
                    Height="30"
                    CornerRadius="9999"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ScrollButtonStyle}"
                    Click="next_Click">
                <FontIcon FontSize="{ThemeResource FlipViewButtonFontSize}"
                          Glyph="&#xEDDA;" />
            </Button>
            <TeachingTip x:Name="Tip"
                         Target="{x:Bind Viewer}"
                         IsLightDismissEnabled="True">
                <TeachingTip.IconSource>
                    <FontIconSource Glyph="&#xE930;" />
                </TeachingTip.IconSource>
            </TeachingTip>
        </Grid>


        <Border Grid.Row="3"
                Height="1"
                VerticalAlignment="Top"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" />
        <TextBlock x:Name="MediaInfo"
                   Grid.Row="3"
                   Margin="5,0,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   IsTextSelectionEnabled="True" />
        <infoFlower:InfoFlower x:Name="Flower"
                               Grid.Row="0"
                               Grid.RowSpan="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" />
    </Grid>


</Window>