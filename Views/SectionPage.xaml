<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="CC98.Views.SectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:dev="using:DevWinUI"
      xmlns:obj="using:CC98.Objects"
      xmlns:infoFlower="using:CC98.Controls"
      Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Page.Resources>
        <DataTemplate x:Key="BoardCase"
                      x:DataType="obj:BoardInfo">
            <HyperlinkButton Content="{x:Bind Name}"
                             Padding="8"
                             Tag="{x:Bind Id}"
                             Click="BoardButton_Click"
                             ToolTipService.ToolTip="{x:Bind Description}"
                             x:Name="BoardButton"
                             Margin="10,0,10,10" />
        </DataTemplate>
        <DataTemplate x:Key="SectionCase"
                      x:DataType="obj:SectionInfo">
            <Expander HorizontalAlignment="Stretch"
                      VerticalContentAlignment="Center">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="15">
                        <TextBlock Text="{x:Bind Name}"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource HarmonySansBold}" />
                        <TextBlock Text="{x:Bind SectionMasters}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                </Expander.Header>
                <Expander.Content>
                    <ItemsRepeater ItemTemplate="{StaticResource BoardCase}"
                                   ItemsSource="{x:Bind Boards}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsJustification="Start"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Expander.Content>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <dev:Stars />
        <Grid Background="{ThemeResource CardGradient2Brush}"
              Padding="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="版面"
                       FontWeight="Bold"
                       FontSize="22"
                       Margin="15,10,10,10" />
            <ScrollViewer Grid.Row="1"
                          Padding="10">
                <ItemsRepeater x:Name="SectionPresenter"
                               ItemsSource="{x:Bind AllSections}"
                               ItemTemplate="{StaticResource SectionCase}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical"
                                     Spacing="10" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <infoFlower:InfoFlower Grid.Row="0"
                                   Grid.RowSpan="2"
                                   x:Name="Flower" />
        </Grid>
    </Grid>

</Page>