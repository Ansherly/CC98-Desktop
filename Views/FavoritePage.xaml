<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CC98.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:dev="using:DevWinUI"
    xmlns:infoFlower="using:CC98.Controls"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">

    <Grid Padding="15,0,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,10,0,10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="收藏集" FontSize="20" FontWeight="Bold" x:Name="de"
                       Foreground="LightSeaGreen" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <ComboBox x:Name="FavoriteBox" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0"
                      PlaceholderText="切换收藏夹" Background="Transparent" ItemsSource="{x:Bind FavoritesList}"
                      SelectionChanged="FavoriteBox_SelectionChanged"
                      dev:MaterialAttach.UseAcrylicBackground="True"
                      SelectedItem="{x:Bind SelectedFavorites,Mode=TwoWay}" Height="35.5">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="obj:Favorites">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" HorizontalAlignment="Right" x:Name="ChangeSort" Click="ChangeSort_Click"
                    Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="StarAdd" FontSize="16" x:Name="SortIcon" />
                    <TextBlock Text="排序" x:Name="SortIndicator" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource AcrylicCardBrush}" BorderThickness="1" CornerRadius="6"
                      Margin="0,0,0,15">
            <ItemsRepeater ItemsSource="{x:Bind Topics}" x:Name="FavoriteTopicRepeater"
                           ElementPrepared="FavoriteTopicRepeater_ElementPrepared">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="obj:SimpleTopicInfo">
                        <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                         CornerRadius="0" x:Name="Content" Click="Content_Click" BorderThickness="0,0.5,0,0.5"
                                         BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                         DataContext="{x:Bind}">
                            <Grid Padding="3,0,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" FontSize="14"  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind BoardName}" Grid.Column="3" Grid.Row="0" VerticalAlignment="Top" FontSize="12"/>
                                <TextBlock Text="{x:Bind Title}" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Time}" Grid.Column="3" Grid.Row="1" FontSize="12" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <HyperlinkButton.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="移除" x:Name="Remove" Click="Remove_Click"
                                                    DataContext="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <ic:SymbolIcon Symbol="Delete" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </HyperlinkButton.ContextFlyout>
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <infoFlower:InfoFlower Grid.Row="0" Grid.RowSpan="2" x:Name="Flower" />
    </Grid>
</Page>