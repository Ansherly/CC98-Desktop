<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="CC98.Views.ForumLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CC98.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ic="using:FluentIcons.WinUI"
      xmlns:dev="using:DevWinUI"
      xmlns:sv="using:CC98.Services"
      xmlns:infoFlower="using:CC98.Controls"
      mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Padding="20"
          Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Opacity="0.8"
          Loaded="RootGrid_Loaded">
        <ContentDialog x:Name="VPNConfigDialog"
                       Title="配置VPN"
                       Closed="VPNConfigDialog_Closed">
            <StackPanel Orientation="Vertical"
                        Spacing="10">
                <TextBox x:Name="VPNUsername"
                         Header="用户名"
                         PlaceholderText="请输入用户名" />
                <PasswordBox x:Name="VPNPassword"
                             Header="密码"
                             PlaceholderText="请输入密码" />
                <TextBox x:Name="CaptchaBox"
                         Header="验证码"
                         PlaceholderText="请输入图形验证码"
                         Visibility="Collapsed"
                         TextChanged="CaptchaBox_TextChanged" />
                <Image x:Name="CaptchaImage"
                       Height="35"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed" />
                <Grid>
                    <Button Content="连接"
                            Click="VPNConfigSave_Click"
                            HorizontalAlignment="Left" />
                    <Button Content="取消"
                            x:Name="VPNCancel"
                            Click="VPNConfigCancel_Click"
                            HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </ContentDialog>
        <StackPanel Spacing="10"
                    x:Name="PasswordLoginPanel">
            <TextBlock Text="登录CC98"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="LightSeaGreen"
                       FontFamily="{StaticResource HarmonySansBold}"
                       VerticalAlignment="Center" />
            <TextBox Header="用户名"
                     x:Name="UserNameBox" />
            <PasswordBox Header="密码"
                         x:Name="PasswordBox" />
            <Grid>
                <dev:BubbleButton x:Name="LoginButton"
                                  HorizontalAlignment="Right"
                                  BubbleForeground="LightBlue"
                                  Padding="10"
                                  Margin="0,15,0,10"
                                  Click="LoginButton_Click"
                                  ToolTipService.ToolTip="登录">
                    <ic:SymbolIcon Symbol="Send"
                                   IconVariant="Color" />
                </dev:BubbleButton>
                <CheckBox x:Name="EnableVpn"
                          Content="启用WebVPN"
                          HorizontalAlignment="Left"
                          Checked="EnableVpn_Checked"
                          Unchecked="EnableVpn_Unchecked"
                          VerticalAlignment="Center" />
            </Grid>

            <Grid>
                <HyperlinkButton x:Name="OpenIdLoginButton"
                                 Content="OpenID登录"
                                 HorizontalAlignment="Left"
                                 ToolTipService.ToolTip="提供更好的安全性"
                                 Click="OpenIdLoginButton_Click" />
                <Border Width="2"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Height="20" />
                <HyperlinkButton x:Name="CheckNetworkButton"
                                 Content="检查网络连接"
                                 HorizontalAlignment="Right"
                                 ToolTipService.ToolTip="检查网络连接"
                                 Click="CheckNetworkButton_Click" />
            </Grid>
        </StackPanel>
        <ProgressRing x:Name="LoadingIndicator"
                      IsActive="False" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Logging">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UserNameBox"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="False" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PasswordBox"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="False" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoginButton"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="False" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenIdLoginButton"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="False" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EnableVpn"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="False" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingIndicator"
                                                       Storyboard.TargetProperty="IsActive">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="True" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Fail">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UserNameBox"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="True" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PasswordBox"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="True" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoginButton"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="True" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenIdLoginButton"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="True" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EnableVpn"
                                                       Storyboard.TargetProperty="IsEnabled">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="True" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingIndicator"
                                                       Storyboard.TargetProperty="IsActive">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                    Value="False" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</Page>
