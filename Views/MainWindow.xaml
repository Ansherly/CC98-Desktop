<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CC98.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CC98"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:picture="using:CC98.Controls.Picture"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    xmlns:sv="using:CC98.Services"
    xmlns:controls="using:CC98.Controls"
    xmlns:dev="using:DevWinUI"
    SystemBackdrop="{ThemeResource AcrylicBackgroundFillColorDefaultBackdrop}">
    
    
    <Grid x:Name="RootGrid" UseLayoutRounding="True" Loaded="RootGrid_Loaded">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="GridTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />

                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="155" />

            </Grid.ColumnDefinitions>
            <ContentDialog x:Name="VPNConfigDialog" Title="配置VPN" Closed="VPNConfigDialog_Closed">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <TextBox x:Name="VPNUsername" Header="用户名" PlaceholderText="请输入用户名"></TextBox>
                    <PasswordBox x:Name="VPNPassword" Header="密码" PlaceholderText="请输入密码"/>
                    <TextBox x:Name="CaptchaBox" Header="验证码" PlaceholderText="请输入图形验证码" Visibility="Collapsed" TextChanged="CaptchaBox_TextChanged"></TextBox>
                    <Image x:Name="CaptchaImage" Height="35" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <Grid>
                        <Button Content="连接" Click="VPNConfigSave_Click" HorizontalAlignment="Left"/>
                        <Button Content="取消" x:Name="VPNCancel" Click="VPNConfigCancel_Click" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ContentDialog>
            <Image Grid.Column="0" Source="/Assets/back.png" Width="28" VerticalAlignment="Center" Margin="5,0,0,3" />
            <Button Grid.Column="1" Width="41" Height="37" Background="Transparent" BorderThickness="0"
                    Margin="3,0,0,0" x:Name="Back" Click="Back_Click" PointerEntered="Back_PointerEntered"
                    PointerExited="Back_PointerExited">
                <AnimatedIcon x:Name="BackIcon">
                    <AnimatedIcon.Source>
                        <animatedvisuals:AnimatedBackVisualSource/>
                    </AnimatedIcon.Source>
                    <AnimatedIcon.FallbackIconSource>
                        <SymbolIconSource Symbol="Back" />
                    </AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>
            </Button>
            <Button Grid.Column="2" Width="41" Height="37" Background="Transparent" BorderThickness="0"
                    Margin="3,0,0,0" x:Name="PaneExpand" Click="PaneExpand_Click"
                    PointerEntered="PaneExpand_PointerEntered" PointerExited="PaneExpand_PointerExited">
                <AnimatedIcon x:Name="NaviIcon">
                    <AnimatedIcon.Source>
                        <animatedvisuals:AnimatedGlobalNavigationButtonVisualSource />
                    </AnimatedIcon.Source>
                    <AnimatedIcon.FallbackIconSource>
                        <SymbolIconSource Symbol="GlobalNavigationButton" />
                    </AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>
            </Button>
            <Grid x:Name="UserArea" Grid.Column="4"/>
            <Button x:Name="VpnButton" Grid.Column="3" Width="41" Height="37"  BorderThickness="0" Background="Transparent" Margin="3,0,0,0">
                <Button.Flyout>
                    <Flyout x:Name="VpnPanel" Placement="Bottom" Opening="VpnPanel_Opening" dev:MaterialAttach.UseAcrylicBackground="True">
                        <Grid MinWidth="120" RowSpacing="10" Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"  Text="VPN连接" HorizontalAlignment="Right"/>
                            <controls:StatusIndicator Grid.Row="0" HorizontalAlignment="Left"  IsConnected="{x:Bind sv:AppSettings.Current.IsVpnEnabled,Mode=OneWay}"></controls:StatusIndicator>
                            <TextBlock Grid.Row="1" x:Name="VpnStatusText" Text="VPN连接状态" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Grid.Row="2" Content="连接" HorizontalAlignment="Center" x:Name="VPNConfigButton" Visibility="Collapsed" Click="VPNConfig_Click"/>
                            <Button Grid.Row="2" Content="断开连接" HorizontalAlignment="Center" x:Name="DisconnectButton" Visibility="Collapsed" Click="DisconnectButton_Click"/>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
                <ic:SymbolIcon Symbol="Remote" FontSize="14"></ic:SymbolIcon>
            </Button>
            <TextBlock Grid.Column="4" Text="CC98 Desktop" x:Name="de" Margin="10,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="15" />
            <Button Grid.Column="5" HorizontalAlignment="Right" Width="30" Height="30" BorderThickness="0"
                    Background="Transparent" VerticalAlignment="Center" x:Name="Me" CornerRadius="9999" Padding="0"
                    RenderTransformOrigin="0.5,0.5" PointerEntered="Me_PointerEntered" PointerExited="Me_PointerExited"
                    PointerPressed="Me_PointerPressed" PointerReleased="Me_PointerReleased"
                    PointerCanceled="Me_PointerCanceled" Click="Me_Click">
                <picture:Picture x:Name="MyPicture" Src="{x:Bind sv:AppSettings.Current.LocalPortraitUrl,Mode=OneWay}" LoadImageCallback="{StaticResource PortraitLoader}" />
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" x:Name="PortScaleTransform" />
                </Button.RenderTransform>
            </Button>
            
        </Grid>


        <NavigationView Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" PaneDisplayMode="Auto"
                        IsPaneOpen="True" OpenPaneLength="240" IsPaneToggleButtonVisible="False" IsBackEnabled="True"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed" x:Name="Navi"
                        MenuItemsSource="{x:Bind MenuItems}" ItemInvoked="Navi_ItemInvoked"
                        FooterMenuItemsSource="{x:Bind FooterMenuItems}">
            <NavigationView.Resources>
                <DataTemplate x:Key="GroupTemplate" x:DataType="obj:NavigationGroup">
                    <NavigationViewItemHeader Content="{x:Bind Name}" />
                </DataTemplate>

                <DataTemplate x:Key="PinnedItemTemplate" x:DataType="obj:NavigationItem">
                    <NavigationViewItem Tag="{x:Bind Tag}">
                        <NavigationViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="取消固定" DataContext="{x:Bind}" Tag="{x:Bind Tag}" x:Name="PinOff" Click="PinOff_Click">
                                    <MenuFlyoutItem.Icon>
                                        <ic:SymbolIcon Symbol="PinOff" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </NavigationViewItem.ContextFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ic:SymbolIcon Symbol="{x:Bind IconSymbol}" FontSize="20" Margin="2,0,10,0" />
                            <TextBlock Text="{x:Bind Name}" />
                        </StackPanel>

                    </NavigationViewItem>
                </DataTemplate>
                <DataTemplate x:Key="ItemTemplate" x:DataType="obj:NavigationItem">
                    <NavigationViewItem Tag="{x:Bind Tag}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ic:SymbolIcon Symbol="{x:Bind IconSymbol}" FontSize="20" Margin="2,0,10,0" />
                            <TextBlock Text="{x:Bind Name}" />
                        </StackPanel>
                    </NavigationViewItem>
                </DataTemplate>
                <obj:NavigationTemplateSelector
                    x:Key="TemplateSelector"
                    GroupTemplate="{StaticResource GroupTemplate}"
                    PinnedItemTemplate="{StaticResource PinnedItemTemplate}"
                    ItemTemplate="{StaticResource ItemTemplate}" />
            </NavigationView.Resources>
            <NavigationView.MenuItemTemplateSelector>
                <StaticResource ResourceKey="TemplateSelector" />
            </NavigationView.MenuItemTemplateSelector>
            <NavigationView.FooterMenuItems>
                <DataTemplate x:DataType="obj:NavigationItem">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="{x:Bind IconSymbol}" FontSize="20" Margin="2,0,10,0" />
                        <TextBlock Text="{x:Bind Name}" />
                    </StackPanel>
                </DataTemplate>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />

        </NavigationView>
        <infoFlower:InfoFlower Grid.Row="0" Grid.RowSpan="3" x:Name="Flower" />
    </Grid>
</Window>