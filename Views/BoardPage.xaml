<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="CC98.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lab="using:CommunityToolkit.Labs.WinUI"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:tool="using:CommunityToolkit.WinUI.Controls"
    xmlns:ubbTextBlock="using:CC98.Controls.UbbTextBlock"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    xmlns:sv="using:CC98.Services"
    xmlns:picture="using:CC98.Controls.Picture"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:CC98.Services.Helpers"
    xmlns:empty="using:CC98.Controls.EmptyState"
    xmlns:sp="using:CC98.Controls.SmartPager"
    NavigationCacheMode="Disabled"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">
    <Grid>
        <SplitView x:Name="SearchView" PanePlacement="Right" DisplayMode="Overlay" PaneBackground="Transparent" OpenPaneLength="380">
            <SplitView.Pane>
                <Grid BorderBrush="{ThemeResource AcrylicCardBrush}" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderThickness="2" Margin="0,10,20,10" CornerRadius="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="版内搜索" Margin="10" Foreground="LightSeaGreen"></TextBlock>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4" Margin="10,0,10,0">
                            <Button Padding="7" ToolTipService.ToolTip="上一页"   x:Name="PreviousPageButton" Click="PreviousPageButton_Click">
                                <ic:SymbolIcon Symbol="ChevronLeft" FontSize="12"></ic:SymbolIcon>
                            </Button>
                            <Button Padding="7" ToolTipService.ToolTip="下一页" x:Name="NextPageButton" Click="NextPageButton_Click">
                                <ic:SymbolIcon Symbol="ChevronRight" FontSize="12"></ic:SymbolIcon>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <dev:TextBox Grid.Row="1" Margin="10,0,10,0" x:Name="BoardSearchBox" TextChanged="BoardSearchBox_TextChanged">
                        <Button Padding="0" x:Name="BoardSearchButton" Click="BoardSearchButton_Click">
                            <ic:SymbolIcon Symbol="Search" FontSize="14"></ic:SymbolIcon>
                        </Button>
                    </dev:TextBox>
                    <ScrollViewer Grid.Row="2" Padding="10">
                        <ItemsRepeater x:Name="ResultRepeater" ItemsSource="{x:Bind searchResultTopics,Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="obj:SearchTopicInfo">
                                    <Button x:Name="SearchResultCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0.5,1,0.5" CornerRadius="0" ToolTipService.ToolTip="{x:Bind Title}" Padding="8" Tag="{x:Bind Id,Mode=OneWay}" Click="SearchResultCard_Click" >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="{x:Bind UserName,Mode=OneWay}" FontFamily="{ThemeResource HarmonySansBold}" VerticalAlignment="Center" Foreground="{ThemeResource SoftPink}" FontSize="13" Margin="8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind HitAndReplyCount,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Time,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                            <Border  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="6" CornerRadius="4" Background="{ThemeResource MarkdownBackgroundBrush}"  Margin="0,4,0,0">
                                                <TextBlock  x:Name="TitleText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                            helper:TextBlockExtensions.HighlightedText="{x:Bind Title}"
                                                            helper:TextBlockExtensions.Keywords="{x:Bind Keyword}"
                                                            helper:TextBlockExtensions.HighlightColor="#C4ABD4"/>
                                            </Border>

                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <ProgressRing x:Name="SearchProgressRing" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False"/>
                </Grid>
            </SplitView.Pane>
            <SplitView.Content>
                <ScrollViewer x:Name="TopicScrollViewer" Grid.Row="0" Padding="15,0,15,0">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="45" />
                                <RowDefinition Height="Auto" MinHeight="45" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon x:Name="BoardSymbol" Symbol="Chat" Grid.Row="0" Grid.RowSpan="2" FontSize="22"
                           Grid.Column="0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{x:Bind BoardData.Name,Mode=OneWay}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind BoardData.Description,Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,10,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind BoardData.BoardMastersString,Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"
                       Margin="0,0,10,10" />
                            <lab:TokenView Grid.Column="3" Grid.Row="0" Grid.RowSpan="2">
                                <lab:TokenItem>
                                    <TextBlock Text="{x:Bind BoardData.TopicCountString,Mode=OneWay}" />
                                </lab:TokenItem>
                                <lab:TokenItem IsSelected="True">
                                    <TextBlock Text="{x:Bind BoardData.TodayCountString,Mode=OneWay}" />
                                </lab:TokenItem>
                            </lab:TokenView>
                        </Grid>

                        <Border Padding="10,10,10,10" x:Name="BannerBox" Visibility="{x:Bind sv:AppSettings.Current.ShowBigPaper,Mode=OneWay,Converter={StaticResource BoolToVisibility}}">
                            <ubbTextBlock:UbbTextBlock x:Name="Banner" UbbText="{x:Bind BoardData.BigPaper,Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       BoldFontFamily="{StaticResource HarmonySansBold}"
                                       QuoteBackground="{ThemeResource QuoteBackgroundBrush}"
                                       QuoteBorder="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       ImageMaxHeight="200"
                                       MediaClicked="Banner_MediaClicked" />
                        </Border>
                        <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <SelectorBar Grid.Column="0" x:Name="TypeSelectorBar" SelectionChanged="TypeSelectorBar_SelectionChanged">
                                    <SelectorBarItem Text="最新"  Tag="latest"></SelectorBarItem>
                                    <SelectorBarItem Text="置顶" Tag="top"></SelectorBarItem>
                                    <SelectorBarItem  Text="精华" Tag="best"></SelectorBarItem>
                                </SelectorBar>
                                <Border Background="{ThemeResource DividerStrokeColorDefaultBrush}" Width="1" Margin="0,6,0,6"></Border>
                                <HyperlinkButton Padding="10" ToolTipService.ToolTip="发主题">
                                    <ic:SymbolIcon Symbol="Drafts" FontSize="16"></ic:SymbolIcon>
                                </HyperlinkButton>
                                <HyperlinkButton Padding="10" >
                                    <ic:SymbolIcon Symbol="Search" FontSize="16" ToolTipService.ToolTip="版内搜索"></ic:SymbolIcon>
                                </HyperlinkButton>
                                <HyperlinkButton Padding="10">
                                    <ic:SymbolIcon Symbol="Pin" FontSize="16" ToolTipService.ToolTip="关注版面"></ic:SymbolIcon>
                                </HyperlinkButton>
                                <HyperlinkButton  Padding="10"  x:Name="MoreButton" ToolTipService.ToolTip="更多操作" Click="MoreButton_Click">
                                    <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="16"></ic:SymbolIcon>
                                    <FlyoutBase.AttachedFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem  Text="浏览器打开">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEB41;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="刷新">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE72C;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </FlyoutBase.AttachedFlyout>
                                </HyperlinkButton>
                            </StackPanel>
                           
                            <sp:SmartPager Grid.Column="2" x:Name="Pager" Margin="0,4,0,4" NumberOfPages="1" SelectedIndexChanged="Pager_SelectedIndexChanged"/>
                        </Grid>
                        
                        <Border Margin="0,0,0,10" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,4,4">
                            <ItemsRepeater x:Name="TopicRepeater" ItemsSource="{x:Bind Topics}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="obj:SimpleTopicInfo">
                                        <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                         CornerRadius="0" x:Name="TileContent" DataContext="{x:Bind}"
                                         Click="TileContent_Click">
                                            <Grid Padding="0,6,0,6" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <ic:SymbolIcon Symbol="ChevronRight" Grid.Column="0" FontSize="14"
                                               Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           helper:TextBlockExtensions.HighlightInfo="{x:Bind HighlightInfo}"
                                                           helper:TextBlockExtensions.HighlightedText="{x:Bind Title}"
                                                           helper:TextBlockExtensions.BoldFontFamily="{ThemeResource HarmonySansBold}"
                                           MaxLines="2" />
                                                <TextBlock Text="{x:Bind UserName}" FontSize="12" Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                                    <ic:SymbolIcon Symbol="Chat" FontSize="11" />
                                                    <TextBlock Text="{x:Bind ReplyCount}" VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5">
                                                    <ic:SymbolIcon Symbol="Fire" FontSize="11" />
                                                    <TextBlock Text="{x:Bind HitCount}" VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </HyperlinkButton>

                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Content>
        </SplitView>
        <infoFlower:InfoFlower x:Name="Flower" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" />
    </Grid>
</Page>