<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="CC98.Views.FollowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:obj="using:CC98.Objects"
    xmlns:picture="using:CC98.Controls.Picture"
    xmlns:infoFlower="using:CC98.Controls.InfoFlower"
    xmlns:empty="using:CC98.Controls.EmptyState"
    xmlns:dev="using:DevWinUI"
    NavigationCacheMode="Required"
    Background="{ThemeResource DesktopAcrylicTransparentBrush}">

    <Grid Padding="15,0,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="75" />
            <RowDefinition Height="12*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="10">
            <TextBlock Text="关注" x:Name="FriendType" FontSize="24" FontWeight="Bold"
                       FontFamily="{StaticResource HarmonySansBold}" Foreground="LightSeaGreen"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
        </Grid>

        <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="7"
                      Margin="0,0,0,30">
            <ItemsRepeater x:Name="FriendRepeater" ItemsSource="{x:Bind Friends}"
                           ElementPrepared="FriendRepeater_ElementPrepared">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="obj:Friend">
                        <HyperlinkButton HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                         CornerRadius="0" x:Name="TileContent" Click="TileContent_Click"
                                         BorderThickness="0.5"
                                         Tag="{x:Bind Id}"
                                         BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <HyperlinkButton.ContextFlyout>
                                <MenuFlyout dev:MaterialAttach.UseAcrylicBackground="True">
                                    <MenuFlyoutItem Text="私信" Click="Chat_Click">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Chat" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="取消关注" Click="UnFollow_Click"  Visibility="{x:Bind IsFollowee, Converter={StaticResource BoolToVisibility},Mode=OneWay}" DataContext="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="PersonDelete" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </HyperlinkButton.ContextFlyout>
                            <Grid Padding="3,0,3,0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="36" Height="36"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="4">
                                    <picture:Picture Src="{x:Bind PortraitUrl}" Stretch="UniformToFill"
                                                     LoadImageCallback="{StaticResource PortraitLoader}" />
                                </Border>

                                <TextBlock Text="{x:Bind Name}" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="帖数" Grid.Column="2" Grid.Row="0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="粉丝" Grid.Column="2" Grid.Row="1"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind PostCount}" Grid.Column="3" Grid.Row="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind FanCount}" Grid.Column="3" Grid.Row="1"
                                           VerticalAlignment="Bottom" />

                            </Grid>
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <empty:EmptyStateControl x:Name="FollowEmptyState" Grid.Row="1" Visibility="Collapsed"
                                 IconGlyph="&#xEC4F;" Title="暂无关注" Subtitle="关注感兴趣的人"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />

        <infoFlower:InfoFlower HorizontalAlignment="Center" x:Name="Flower" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</Page>