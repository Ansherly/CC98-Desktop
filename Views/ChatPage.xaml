<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="CC98.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:ic="using:FluentIcons.WinUI"
      xmlns:obj="using:CC98.Objects"
      xmlns:picture="using:CC98.Controls"
      xmlns:ubbTextBlock="using:CC98.Controls.UbbTextBlock"
      xmlns:infoFlower="using:CC98.Controls"
      xmlns:tool="using:CommunityToolkit.WinUI.Controls"
      xmlns:dev="using:DevWinUI"
      xmlns:empty="using:CC98.Controls"
      Background="{ThemeResource DesktopAcrylicTransparentBrush}">


    <Grid>
        <Grid.Resources>
            <Flyout x:Name="EmojiFlyout"
                    Opening="EmojiFlyout_Opening"
                    dev:MaterialAttach.UseAcrylicBackground="True">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GridView x:Name="EmojiGrid"
                              Grid.Row="0"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="EmojiGrid_ItemClick"
                              MaxWidth="340"
                              MaxHeight="220"
                              Padding="6">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="obj:Emoji">
                                <Border CornerRadius="2"
                                        Padding="2">
                                    <Image Source="{x:Bind EmojiPath}"
                                           Width="32"
                                           Height="32"
                                           Stretch="Uniform"
                                           ToolTipService.ToolTip="{x:Bind EmojiName}" />
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Border Grid.Row="1"
                            Height="1"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <!--  分类栏:GridView 自带选中高亮,点击切换表情分类  -->
                    <GridView x:Name="EmojiCategoryBar"
                              Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="EmojiCategory_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollMode="Enabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="obj:EmojiCategoryInfo">
                                <Image Source="{x:Bind IconPath}"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform"
                                       ToolTipService.ToolTip="{x:Bind Name}" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Flyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <dev:TextBox Grid.Row="0"
                     Grid.Column="0"
                     x:Name="SearchUser"
                     PlaceholderText="搜索用户名"
                     HorizontalAlignment="Stretch"
                     Margin="12"
                     KeyDown="SearchUser_KeyDown">
            <Button x:Name="Confirm"
                    Click="Confirm_Click">
                <ic:SymbolIcon Symbol="Search" />
            </Button>
        </dev:TextBox>
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Height="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" />
        <ListView Grid.Row="2"
                  Grid.Column="0"
                  x:Name="UserList"
                  SelectionChanged="ContactRepeater_SelectionChanged"
                  ContainerContentChanging="UserList_ContainerContentChanging"
                  ItemsSource="{x:Bind ChatInfoList}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="obj:ChatInfo">
                    <Grid Padding="10"
                          RowSpacing="5"
                          ColumnSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                CornerRadius="5"
                                Height="45"
                                Width="45">
                            <picture:Picture Src="{x:Bind PortraitUrl}"
                                             Stretch="UniformToFill"
                                             LoadImageCallback="{StaticResource PortraitLoader}" />
                        </Border>
                        <TextBlock Text="{x:Bind Name}"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   FontSize="15" />
                        <TextBlock Text="{x:Bind LastContent}"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="1" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <empty:EmptyStateControl x:Name="UserListEmptyState"
                                 Grid.Row="2"
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 IconGlyph="&#xEC4F;"
                                 Title="暂无联系人"
                                 Subtitle="暂无会话"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        <Border Grid.Column="1"
                Grid.RowSpan="3"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Width="1"
                BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform X="6" />
            </Border.RenderTransform>
        </Border>
        <tool:GridSplitter Grid.Column="1"
                           Grid.Row="0"
                           Grid.RowSpan="3"
                           Canvas.ZIndex="2">
            <tool:GridSplitter.RenderTransform>
                <TranslateTransform X="6" />
            </tool:GridSplitter.RenderTransform>
        </tool:GridSplitter>
        <Grid Grid.Row="0"
              Grid.Column="2"
              Margin="15,0,15,0">
            <TextBlock FontFamily="{StaticResource HarmonySansBold}"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Foreground="LightSeaGreen"
                       Text="{x:Bind ((obj:ChatInfo)UserList.SelectedItem).Name, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Click="Ref_Click"
                        x:Name="Ref"
                        Padding="7"
                        BorderThickness="1"
                        ToolTipService.ToolTip="最新信息">
                    <ic:SymbolIcon Symbol="ArrowSync"
                                   FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Grid.Column="2"
              RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition MinHeight="60"
                               MaxHeight="130" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ScrollViewer x:Name="HistoryViewer"
                              Padding="10,0,15,0"
                              ViewChanged="HistoryViewer_ViewChanged">
                    <ItemsRepeater x:Name="MessagesList"
                                   ItemsSource="{x:Bind Messages}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="obj:ChatMessage">
                                <Border Margin="0,10"
                                        HorizontalAlignment="{x:Bind IsMe, Converter={StaticResource AlignmentConverter}}"
                                        BorderBrush="{ThemeResource AcrylicCardBrush}"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Height="Auto"
                                        MaxWidth="350"
                                        MinWidth="200">
                                    <StackPanel>
                                        <ubbTextBlock:UbbTextBlock UbbText="{x:Bind Content}"
                                                                   HorizontalAlignment="{x:Bind IsMe, Converter={StaticResource AlignmentConverter}}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   QuoteBackground="{ThemeResource QuoteBackgroundBrush}"
                                                                   QuoteBorder="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                                   BoldFontFamily="{StaticResource HarmonySansBold}"
                                                                   ImageMaxWidth="400"
                                                                   MediaClicked="UbbTextBlock_MediaClicked" />
                                        <TextBlock Text="{x:Bind Time}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="10" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <!--  上滑加载更早消息时的顶部进度环  -->
                <ProgressRing x:Name="LoadingMore"
                              IsActive="False"
                              Visibility="Collapsed"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Margin="0,8,0,0" />
                <empty:EmptyStateControl x:Name="ChatEmptyState"
                                         Visibility="Collapsed"
                                         IconGlyph="&#xEC4F;"
                                         Title="暂无聊天记录"
                                         Subtitle="开始聊天吧"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1"
                    Height="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" />
            <Grid Grid.Row="2"
                  Margin="10,0,10,0">
                <StackPanel HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="5">
                    <HyperlinkButton Padding="7"
                                     Tag="emoji"
                                     Click="ToolButton_Click">
                        <FontIcon Glyph="&#xED58;" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7"
                                     Tag="img"
                                     Click="ToolButton_Click">
                        <ic:SymbolIcon Symbol="Image" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7"
                                     Tag="upload"
                                     Click="ToolButton_Click">
                        <ic:SymbolIcon Symbol="Folder" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7"
                                     Tag="b"
                                     Click="ToolButton_Click">
                        <ic:SymbolIcon Symbol="TextBold" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7"
                                     Tag="i"
                                     Click="ToolButton_Click">
                        <ic:SymbolIcon Symbol="TextItalic" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7"
                                     Tag="del"
                                     Click="ToolButton_Click">
                        <ic:SymbolIcon Symbol="TextStrikethrough" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="7"
                                     Tag="quote"
                                     Click="ToolButton_Click">
                        <ic:SymbolIcon Symbol="CommentQuote" />
                    </HyperlinkButton>
                </StackPanel>
                <HyperlinkButton x:Name="SendButton"
                                 HorizontalAlignment="Right"
                                 Padding="7"
                                 Click="Send_Click">
                    <ic:SymbolIcon Symbol="Send" />
                </HyperlinkButton>
            </Grid>


            <TextBox x:Name="ReplyBody"
                     Grid.Row="3"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     CornerRadius="0" />
        </Grid>
        <infoFlower:InfoFlower x:Name="Flower"
                               Grid.Row="0"
                               Grid.RowSpan="3"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" />

    </Grid>

</Page>