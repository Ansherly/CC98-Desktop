    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
	<LangVersion>preview</LangVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CC98</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
   
 <SelfContained>true</SelfContained>
 
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <!--
      视频播放器把自建的 DXGI 交换链挂到 SwapChainPanel 上,用到旧式 ComImport 接口
      (ISwapChainPanelNative);PublishAot/Trim 会把内置 COM 关掉,运行时直接
      “Built-in COM has been disabled”。WinUI 控件的子类也会因此撑不住:Content
      赋值走 AOT 优化路径同样依赖内置 COM。
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
	  <WindowsSdkPackageVersion>10.0.26100.81</WindowsSdkPackageVersion>
  </PropertyGroup>
