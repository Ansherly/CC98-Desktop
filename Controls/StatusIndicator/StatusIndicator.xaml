<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="CC98.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CC98.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">


    <Grid>
        <Grid Width="20"
              Height="20">
            <!--  外层光晕  -->
            <Ellipse Width="20"
                     Height="20"
                     Fill="{x:Bind IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"
                     Opacity="0.3" />

            <!--  内层实心圆点  -->
            <Ellipse Width="12"
                     Height="12"
                     Fill="{x:Bind IsConnected, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
