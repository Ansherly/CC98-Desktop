<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="CC98.Controls.Picture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lab="using:CommunityToolkit.WinUI.Controls"
    x:Name="Root"
    mc:Ignorable="d">

    <Grid>
        <Image x:Name="Viewer" Stretch="{x:Bind Stretch, Mode=OneWay}"/>
        <lab:Shimmer x:Name="shimmer" Width="400" Height="240" IsActive="True" />
        <Button x:Name="DisplayButton" Content="点击显示图片" Visibility="Collapsed" Click="DisplayButton_Click" />
    </Grid>
</UserControl>