<!--  VideoPlayer.xaml  -->
<UserControl x:Class="CC98.Controls.VideoPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualPrimaryBrush="Transparent"
             FocusVisualSecondaryBrush="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  控制条要压在视频画面上:深色主题用半透明黑 + 白字,浅色主题用半透明白 + 黑字  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="VideoBarBackgroundBrush"
                                     Color="#B3000000" />
                    <SolidColorBrush x:Key="VideoBarForegroundBrush"
                                     Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VideoBarBackgroundBrush"
                                     Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="VideoBarForegroundBrush"
                                     Color="#E4000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="VideoBarBackgroundBrush"
                                     Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="VideoBarForegroundBrush"
                                     Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  与 MusicPlayer 保持一致:主色取 CC98 传统链接色  -->
            <SolidColorBrush x:Key="VideoAccentBrush"
                             Color="LightSeaGreen" />
            <SolidColorBrush x:Key="VideoAccentHoverBrush"
                             Color="DarkCyan" />
            <SolidColorBrush x:Key="VideoAccentPressedBrush"
                             Color="Teal" />

            <!--  音量浮层:贴住控制条,去掉默认那一圈厚内边距  -->
            <Style x:Key="VideoFlyoutPresenterStyle"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                   TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="Black">

        <!--  mpv 的渲染面:OpenGL 画到共享纹理,再由 SwapChainPanel 交给 XAML 合成  -->
        <SwapChainPanel x:Name="Surface"
                        Visibility="Collapsed" />

        <ProgressRing x:Name="BusyRing"
                      Width="36"
                      Height="36"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="False"
                      Visibility="Collapsed" />

        <TextBlock x:Name="ErrorText"
                   MaxWidth="320"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!--  播放控制条  -->
        <Grid x:Name="ControlBar"
              Height="38"
              Padding="4,0"
              VerticalAlignment="Bottom"
              Background="{ThemeResource VideoBarBackgroundBrush}"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{ThemeResource VideoBarForegroundBrush}"
                    ToolTipService.ToolTip="播放/暂停"
                    Click="PlayPauseButton_Click">
                <FontIcon x:Name="PlayPauseIcon"
                          FontSize="12"
                          Glyph="&#xE768;" />
            </Button>

            <TextBlock x:Name="PositionText"
                       Grid.Column="1"
                       Margin="2,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource VideoBarForegroundBrush}"
                       FontSize="11"
                       Text="00:00" />

            <Slider x:Name="SeekSlider"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="SeekSlider_ValueChanged">
                <Slider.Resources>
                    <StaticResource x:Key="SliderTrackValueFill"
                                    ResourceKey="VideoAccentBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPointerOver"
                                    ResourceKey="VideoAccentHoverBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPressed"
                                    ResourceKey="VideoAccentPressedBrush" />
                    <!--  实测:拇指里那颗圆点由 SliderThumbBackground 控制  -->
                    <StaticResource x:Key="SliderThumbBackground"
                                    ResourceKey="VideoAccentBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver"
                                    ResourceKey="VideoAccentHoverBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed"
                                    ResourceKey="VideoAccentPressedBrush" />
                </Slider.Resources>
            </Slider>

            <TextBlock x:Name="DurationText"
                       Grid.Column="3"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource VideoBarForegroundBrush}"
                       FontSize="11"
                       Text="00:00" />

            <!--  音量:外面一颗喇叭按钮,浮层里是静音键 + 音量条(与 MusicPlayer 同款)  -->
            <Button x:Name="VolumeButton"
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{ThemeResource VideoBarForegroundBrush}"
                    ToolTipService.ToolTip="音量">
                <FontIcon x:Name="VolumeIcon"
                          FontSize="12"
                          Glyph="&#xE767;" />
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight"
                            FlyoutPresenterStyle="{StaticResource VideoFlyoutPresenterStyle}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="MuteButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="静音"
                                    Click="MuteButton_Click">
                                <FontIcon Glyph="&#xE74F;"
                                          FontSize="14" />
                            </Button>
                            <Slider x:Name="VolumeSlider"
                                    Width="120"
                                    MinHeight="18"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="100"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged">
                                <Slider.Resources>
                                    <StaticResource x:Key="SliderTrackValueFill"
                                                    ResourceKey="VideoAccentBrush" />
                                    <StaticResource x:Key="SliderTrackValueFillPointerOver"
                                                    ResourceKey="VideoAccentHoverBrush" />
                                    <StaticResource x:Key="SliderTrackValueFillPressed"
                                                    ResourceKey="VideoAccentPressedBrush" />
                                    <StaticResource x:Key="SliderThumbBackground"
                                                    ResourceKey="VideoAccentBrush" />
                                    <StaticResource x:Key="SliderThumbBackgroundPointerOver"
                                                    ResourceKey="VideoAccentHoverBrush" />
                                    <StaticResource x:Key="SliderThumbBackgroundPressed"
                                                    ResourceKey="VideoAccentPressedBrush" />
                                </Slider.Resources>
                            </Slider>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
