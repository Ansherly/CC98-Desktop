<!--  BilibiliPlayer.xaml:UBB [bili] 的内嵌播放卡片  -->
<UserControl x:Class="CC98.Controls.BilibiliPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.WinUI"
             FocusVisualPrimaryBrush="Transparent"
             FocusVisualSecondaryBrush="Transparent">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            MaxWidth="480"
            HorizontalAlignment="Left"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                媒体区:未播放时是封面 + 播放按钮;播放后换成播放器。
                高度在代码里按 16:9 计算(并夹在合理区间),不写死。
            -->
            <Grid x:Name="MediaHost"
                  MinHeight="120"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="#14808080">

                <!--  无封面时的渐变底色,避免卡片是一片空白  -->
                <Border x:Name="CoverFallback">
                    <Border.Background>
                        <LinearGradientBrush Opacity="0.22"
                                             StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FB7299" />
                            <GradientStop Offset="1" Color="#3286EE" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Image x:Name="CoverImage"
                       Opacity="0"
                       Stretch="UniformToFill" />

                <!--  压暗层:让按钮与状态文字在任何封面上都可读  -->
                <Grid x:Name="CoverOverlay">
                    <Border Background="#40000000" />

                    <Button x:Name="PlayButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="播放 B 站视频"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlayButton_Click">
                        <ic:SymbolIcon Symbol="Play"
                                       FontSize="30"
                                       Foreground="White" />
                    </Button>

                    <ProgressRing x:Name="BusyRing"
                                  Width="36"
                                  Height="36"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  Foreground="White" />


                    <TextBlock x:Name="StatusText"
                               Margin="12,0,12,12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               FontSize="12"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>

                <!--  右上角时长角标  -->
                <Border x:Name="DurationBadge"
                        Margin="0,8,8,0"
                        Padding="6,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#80000000"
                        CornerRadius="3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DurationText"
                               FontSize="11"
                               Foreground="White" />
                </Border>

                <!--  播放器宿主:点击播放后才创建 VideoPlayer,不用时不占任何媒体资源  -->
                <Grid x:Name="PlayerHost"
                      Visibility="Collapsed" />
            </Grid>

            <!--  信息栏:标题 / UP 主 / 打开原页  -->
            <Grid Grid.Row="1"
                  Padding="10,6,6,6"
                  ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="1">
                    <TextBlock x:Name="TitleText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <HyperlinkButton x:Name="OpenInBrowserButton"
                                 Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Click="OpenInBrowserButton_Click"
                                 >
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8A7;" FontSize="15"></FontIcon>
                        <TextBlock Text="在 B 站打开" FontSize="13"/>
                    </StackPanel>
                    
                </HyperlinkButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
