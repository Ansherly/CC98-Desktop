<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CC98.Controls">


    <!--
    代码块控件模板:结构参考 CC98\Controls\CodeBlock(该实现放在 UBB 里没有滚轮问题)。
    要点:用 Grid + 行定义(Auto / *)包住 ScrollViewer,且不要显式设置 ScrollMode,
    ScrollViewer 的视口高度就等于内容高度 → 纵向没有可滚动范围,滚轮会自然交给外层。
-->
    <Style TargetType="local:CodeBlock">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CodeBlock">
                    <Grid
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                        x:Name="PART_LanguageTag"
                        Grid.Row="0"
                        Margin="3,0,3,2"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0.55"
                        Text=""
                        Visibility="Collapsed" />
                        <ScrollViewer
                        x:Name="PART_Scroller"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                            <RichTextBlock
                            x:Name="PART_Viewer"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
